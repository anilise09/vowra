<?xml version="1.0" encoding="utf-8"?>
<!-- Vawra keeps nothing in cloud backups or device-to-device transfers: sign-in
     tokens, cached chats and settings stay on this phone only. Signing in again
     on a new phone brings the account back from the server. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
